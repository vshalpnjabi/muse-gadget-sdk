# Copy to sdkconfig.muse-waveshare-s3-175c.local (git ignores it) and fill in.
# tools/muse/board.sh applies it last, so secrets never enter a committed file.

# Muse SDK token (mgst_..., from gadgets.muse.ai > Account > SDK tokens): every build needs it.
CONFIG_GADGET_SDK_TOKEN=""

# Voice guard: the relay's X-VG-Token, its addresses (home first, then HTTPS) and
# the enrolled speaker. With no token, speaker or address it stays off.
CONFIG_MUSE_VG_TOKEN=""
CONFIG_MUSE_VG_HOME_BASE="http://192.168.1.10:8792"
CONFIG_MUSE_VG_AWAY_BASE="https://relay.example.ts.net/vg"
CONFIG_MUSE_VG_SPEAKER="me"

# Your avatar files (muse_pixel.c, muse_photo_img.c), kept outside the repository
# so every checkout builds with them. Empty: components/muse/avatar/.
CONFIG_MUSE_AVATAR_DIR=""
