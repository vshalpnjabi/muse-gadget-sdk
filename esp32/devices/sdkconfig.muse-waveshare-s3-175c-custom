# This fork's Waveshare ESP32-S3-Touch-AMOLED-1.75C build (CUSTOMIZATIONS.md):
# applied after devices/sdkconfig.muse-waveshare-s3-175c by tools/muse/board.sh.
# Secrets and per-machine values (tokens, the voice guard's addresses and speaker,
# the avatar folder) go in sdkconfig.muse-waveshare-s3-175c.local, which git
# ignores; see sdkconfig.muse-waveshare-s3-175c.local.example. The same features
# without anything personal: devices/sdkconfig.muse-features (MUSE_FEATURES=1).

# Names: the companion as the board calls it, and the owner it serves.
CONFIG_MUSE_NAME="Vi"
CONFIG_MUSE_OWNER_NAME="Vishal"

# Live voice calls with Muse, push-to-talk on the one button, Muse greets first.
CONFIG_MUSE_REALTIME_VOICE=y
CONFIG_MUSE_REALTIME_VOICE_GREETING=y
CONFIG_MUSE_PTT_CALLS=y
# Speaker boost ceiling (Settings > Sound > Speaker boost goes up to it).
CONFIG_MUSE_SPEAKER_MAX_DB=12

# The face: touch sounds, a fixed avatar size under captions.
CONFIG_MUSE_UI_TOUCH_SOUNDS=y
CONFIG_MUSE_UI_FIXED_AVATAR=y
# A plainer home screen: no READY text, mode names, ring or power icon; the
# battery as a bare percentage; a plain speaker icon; small captions.
CONFIG_MUSE_UI_HIDE_READY=y
CONFIG_MUSE_UI_HIDE_MODE_NAMES=y
CONFIG_MUSE_UI_NO_RING=y
CONFIG_MUSE_UI_NO_AUX_ICON=y
CONFIG_MUSE_UI_BATTERY_PERCENT_ONLY=y
CONFIG_MUSE_UI_PLAIN_SPEAKER=y
CONFIG_MUSE_UI_SMALL_CAPTIONS=y
# The default theme: Muse (the Muse app's own look).
CONFIG_MUSE_DEFAULT_THEME=0

# Wi-Fi static buffers 6 and RX block-ack window 12: leaves the 16 KiB of
# DMA-capable RAM the Noise link needs to send link.register.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=12

# Clock, sleep hours and do not disturb; the time zone (POSIX TZ).
CONFIG_MUSE_CLOCK=y
CONFIG_MUSE_TIMEZONE="PST8PDT,M3.2.0,M11.1.0"
# Motion sensor (QMI8658): tilt, shake, auto-rotate.
CONFIG_MUSE_IMU=y

# Voice guard (speaker verification); its relay's addresses, speaker and token
# are in the .local overlay.
CONFIG_MUSE_VOICE_GUARD=y
CONFIG_MUSE_VG_ENFORCE=y

# Wake word "Hey Vi" (components/muse/wake/README.md).
CONFIG_MUSE_WAKE_WORD=y
CONFIG_MUSE_WAKE_MODEL="wake/hey_vi.tflite"
CONFIG_MUSE_WAKE_PHRASE="Hey Vi"
CONFIG_MUSE_WAKE_CUTOFF=98
CONFIG_MUSE_WAKE_WINDOW=5
CONFIG_MUSE_WAKE_ARENA=40000

# Internal RAM for the link's DMA headroom: the avatar's and audio's statics in PSRAM.
CONFIG_MUSE_STATIC_BUFFERS_IN_PSRAM=y
